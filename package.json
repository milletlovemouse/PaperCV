{
  "name": "papercv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "node --import tsx tests/e2e/editor.e2e.ts",
    "test:richtext": "node --import tsx tests/e2e/rich-text.e2e.ts",
    "test:ui": "node --import tsx tests/e2e/ui.e2e.ts",
    "test:select": "node --import tsx tests/e2e/select.e2e.ts",
    "test:identity": "node --import tsx tests/e2e/identity.e2e.ts",
    "test:templates": "node --import tsx tests/e2e/templates.e2e.ts",
    "test:layout": "node --import tsx tests/e2e/layout.e2e.ts",
    "test:preview": "node --import tsx tests/e2e/preview-layout.e2e.ts",
    "test:presentation": "node --import tsx tests/integration/presentation-pdf.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "preview": "vite preview",
    "test:mobile-print": "node --import tsx tests/e2e/mobile-print.e2e.ts",
    "test:print": "node --import tsx tests/e2e/print.e2e.ts",
    "lint:staged": "lint-staged",
    "commitlint": "commitlint",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@radix-ui/themes": "^3.3.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.2.6",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "4.10.38",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20",
    "@commitlint/config-conventional": "^20",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "husky": "^9",
    "lint-staged": "^16",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.56.0",
    "postcss-custom-media": "^11",
    "postcss-nesting": "^13",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.2"
  },
  "packageManager": "pnpm@9.15.3",
  "license": "MIT"
}
